# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 로컬 도구 산출물
/.memsearch/
.gstack/

# 학생 개인정보 — 절대 커밋·배포 금지.
# 이 사이트는 output:"export" 정적 공개 배포이므로 학생 데이터가 저장소에 들어가면 그대로 공개된다.
# 학생 명부 DB와 생성된 앱은 전부 여기에만 둔다.
/roster-data/
